# Supabase project (Dashboard > Project Settings > API). Public read-only keys for the site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection as the postgres user (Dashboard > Connect > Session pooler, port 5432).
# Use the session pooler, not Direct connection: the direct host is IPv6-only and GitHub Actions has no IPv6.
# Used by the ETL scripts and the migration runner, locally and in GitHub Actions. Never deployed to Vercel.
DATABASE_URL=

# Optional. Raises Socrata rate limits (free: https://data.cityofchicago.org/profile/app_tokens).
SOCRATA_APP_TOKEN=

# Optional. Census 2020 housing units per ward (free: https://api.census.gov/data/key_signup.html).
# Without it, scripts/load-denominator.ts falls back to Cook County Assessor parcel counts.
CENSUS_API_KEY=

# Optional. Vercel deploy hook URL, called at the end of a successful ETL run to revalidate.
VERCEL_DEPLOY_HOOK=

# Web app only: "supabase" (default when NEXT_PUBLIC_SUPABASE_URL is set) or "fixture"
# (reads data/fixtures/snapshot.json written by `npm run etl -- --dry-run`).
DATA_SOURCE=
